@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div asp-validation-summary="All" class="text-danger"></div>
<div class="main-agileinfo">
    <div class="agileits-top">
        <form asp-action="SendEmail">

            <input class="text email" asp-for="Email" placeholder="Email" required="">
            <span asp-validation-for="Email" class="text-danger"></span>

            <input type="submit" value="Rest Password">
        </form>
    </div>
</div>
@section _ValidationScriptSection
{
    <partial name="_ValidationScriptsPartial" />
}